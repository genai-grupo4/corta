# Copiar a .env para desarrollo local. El .env real no se versiona.

# Puerto HTTP. En Railway lo inyecta la plataforma, no lo definas a mano.
PORT=3000

# Ruta del store JSON. Solo se usa si DATABASE_URL esta vacia.
DATA_FILE=data/links.json

# Postgres. Si esta definida, Corta la usa en lugar del archivo JSON.
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://usuario:password@host:5432/corta
